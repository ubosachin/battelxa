# ==============================================================================
# BATTLEXA - Environment Variables Configuration (.env.example)
# ==============================================================================

# Application URL & Mode
NEXT_PUBLIC_APP_NAME="BATTLEXA"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# MongoDB Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb://localhost:27017/battlexa"

# Authentication (JWT Secret - Generate via `openssl rand -hex 32`)
JWT_SECRET="battlexa_super_secret_jwt_encryption_key_change_in_production_32chars!"
JWT_EXPIRES_IN="7d"

# Razorpay Payments Gateway
# Get keys from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_sampleKeyId12345"
RAZORPAY_KEY_SECRET="sampleKeySecretVal123456789"
RAZORPAY_WEBHOOK_SECRET="sampleWebhookSecretVal12345"

# Cloudinary Media Storage
# Get credentials from https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="battlexa-cloud"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sampleCloudinaryApiSecretKey"

# Admin Bootstrap (Used during initial seeding or platform setup)
ADMIN_BOOTSTRAP_EMAIL="admin@battlexa.gg"
ADMIN_BOOTSTRAP_PASSWORD="BattlexaSuperAdminPass2026!"
ADMIN_BOOTSTRAP_NAME="Battlexa Commander"

# Google OAuth 2.0 Credentials
# Setup at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="sample_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="sample_google_client_secret"

# Discord OAuth 2.0 Credentials
# Setup at: https://discord.com/developers/applications
DISCORD_CLIENT_ID="sample_discord_client_id"
DISCORD_CLIENT_SECRET="sample_discord_client_secret"

# ==============================================================================
# Match Notification & Broadcast Delivery Channels (Discord & Email)
# ==============================================================================

# SMTP Email Notification Service (Gmail, Brevo, SendGrid, Amazon SES)
# For Gmail: Use smtp.gmail.com with port 465 (SSL) and a 16-character Google App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="\"BATTLEXA Arena\" <your-email@gmail.com>"

# Discord Match Announcement & Room ID/Pass Webhook
# Setup: Discord Server -> Channel Settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"
DISCORD_MATCH_ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"

# Discord Bot Token & Server ID (For automatic guild join on login & DMs)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_GUILD_ID="your_discord_server_guild_id_here"

# Public Discord Server Permanent Invite Link (Shown in emails and match lobbies)
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/your-server-code"
